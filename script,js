/**
 * Hugot ng Gabi — Random Hugot Generator
 * Vanilla JS, no dependencies. Wrapped in an IIFE to avoid global pollution.
 */
(() => {
  "use strict";

  /* ==========================================================================
     Constants
     ========================================================================== */

  const DATA_URL = "hugot.json";
  const STORAGE_KEYS = {
    favorites: "hugot:favorites",
    submissions: "hugot:submissions",
  };
  const SHUFFLE_DURATION_MS = 1000;
  const SHUFFLE_TICK_MS = 70;
  const TOAST_DURATION_MS = 2600;
  const MAX_HUGOT_LENGTH = 300;

  const REDUCED_MOTION = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ==========================================================================
     State
     ========================================================================== */

  const state = {
    hugots: [],
    currentHugot: null,
    favorites: [],
    isShuffling: false,
    isSubmitting: false,
  };

  /* ==========================================================================
     DOM cache
     ========================================================================== */

  const dom = {
    eyebrow: document.getElementById("eyebrow"),

    loadingState: document.getElementById("loadingState"),
    errorState: document.getElementById("errorState"),
    retryButton: document.getElementById("retryButton"),

    quoteBlock: document.getElementById("quoteBlock"),
    quoteText: document.getElementById("quoteText"),
    quoteIndex: document.getElementById("quoteIndex"),

    cardActions: document.getElementById("cardActions"),
    controls: document.getElementById("controls"),

    copyButton: document.getElementById("copyButton"),
    copyButtonLabel: document.getElementById("copyButtonLabel"),
    favoriteButton: document.getElementById("favoriteButton"),

    randomButton: document.getElementById("randomButton"),
    surpriseButton: document.getElementById("surpriseButton"),
    submitOpenButton: document.getElementById("submitOpenButton"),

    favoritesToggle: document.getElementById("favoritesToggle"),
    favoritesCount: document.getElementById("favoritesCount"),
    drawerOverlay: document.getElementById("drawerOverlay"),
    favoritesDrawer: document.getElementById("favoritesDrawer"),
    drawerClose: document.getElementById("drawerClose"),
    drawerBody: document.getElementById("drawerBody"),
    drawerEmpty: document.getElementById("drawerEmpty"),
    drawerList: document.getElementById("drawerList"),

    modalOverlay: document.getElementById("modalOverlay"),
    submitModal: document.getElementById("submitModal"),
    modalClose: document.getElementById("modalClose"),
    submitForm: document.getElementById("submitForm"),
    submitName: document.getElementById("submitName"),
    submitText: document.getElementById("submitText"),
    submitTextCount: document.getElementById("submitTextCount"),
    submitTextError: document.getElementById("submitTextError"),
    submitFormButton: document.getElementById("submitFormButton"),
    submitFormButtonLabel: document.getElementById("submitFormButtonLabel"),

    toastRegion: document.getElementById("toastRegion"),
  };

  /* ==========================================================================
     Utilities
     ========================================================================== */

  /** Returns a random integer index within [0, length). */
  function randomIndex(length) {
    return Math.floor(Math.random() * length);
  }

  /** Picks a random hugot from state.hugots, avoiding the currently shown one when possible. */
  function pickRandomHugot(excludeId) {
    const pool = state.hugots.length > 1
      ? state.hugots.filter((h) => h.id !== excludeId)
      : state.hugots;
    return pool[randomIndex(pool.length)];
  }

  function readStorage(key, fallback) {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : fallback;
    } catch (err) {
      console.warn(`Could not read localStorage key "${key}"`, err);
      return fallback;
    }
  }

  function writeStorage(key, value) {
    try {
      localStorage.setItem(key, JSON.stringify(value));
    } catch (err) {
      console.warn(`Could not write localStorage key "${key}"`, err);
    }
  }

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str;
    return div.innerHTML;
  }

  const FOCUSABLE_SELECTOR =
    'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';

  /**
   * Traps Tab/Shift+Tab focus cycling within `container` while `isActive()` returns true.
   * Returns a teardown function that removes the listener.
   */
  function trapFocus(container, isActive) {
    function onKeydown(event) {
      if (event.key !== "Tab" || !isActive()) return;

      const focusable = Array.from(container.querySelectorAll(FOCUSABLE_SELECTOR)).filter(
        (el) => el.offsetParent !== null
      );
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    container.addEventListener("keydown", onKeydown);
    return () => container.removeEventListener("keydown", onKeydown);
  }

  /**
   * Marks everything outside `keepEls` as inert so background content is
   * unreachable to AT/Tab while a drawer or modal is open.
   */
  function setBackgroundInert(keepEls, isInert) {
    const keep = Array.isArray(keepEls) ? keepEls : [keepEls];
    Array.from(document.body.children).forEach((child) => {
      if (keep.some((el) => child === el || child.contains(el))) return;
      if (isInert) {
        child.setAttribute("inert", "");
      } else {
        child.removeAttribute("inert");
      }
    });
  }

  /* ==========================================================================
     Toasts
     ========================================================================== */

  function showToast(message, variant = "success") {
    const toast = document.createElement("div");
    toast.className = `toast toast--${variant}`;
    toast.innerHTML = `<span class="toast__dot" aria-hidden="true"></span><span>${escapeHtml(message)}</span>`;
    dom.toastRegion.appendChild(toast);

    window.setTimeout(() => {
      toast.classList.add("is-leaving");
      toast.addEventListener("animationend", () => toast.remove(), { once: true });
      // Fallback removal in case animation is skipped (reduced motion)
      window.setTimeout(() => toast.remove(), 400);
    }, TOAST_DURATION_MS);
  }

  /* ==========================================================================
     Data loading
     ========================================================================== */

  async function loadHugots() {
    setCardState("loading");
    try {
      const response = await fetch(DATA_URL, { cache: "no-store" });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json();

      if (!Array.isArray(data) || data.length === 0) {
        throw new Error("Empty or malformed hugot data");
      }

      state.hugots = data;
      setCardState("ready");
      displayHugot(pickRandomHugot(null), { animate: false });
    } catch (err) {
      console.error("Failed to load hugot.json:", err);
      setCardState("error");
    }
  }

  function setCardState(mode) {
    const isLoading = mode === "loading";
    const isError = mode === "error";
    const isReady = mode === "ready";

    dom.loadingState.hidden = !isLoading;
    dom.errorState.hidden = !isError;
    dom.quoteBlock.hidden = !isReady;
    dom.cardActions.hidden = !isReady;
    dom.controls.hidden = !isReady;
  }

  /* ==========================================================================
     Rendering the hugot
     ========================================================================== */

  function displayHugot(hugot, { animate = true } = {}) {
    if (!hugot) return;
    state.currentHugot = hugot;

    const renderContent = () => {
      dom.quoteText.textContent = hugot.text;
      dom.quoteIndex.textContent = `#${String(hugot.id).padStart(2, "0")}`;
      updateFavoriteButtonState();
    };

    if (!animate || REDUCED_MOTION) {
      renderContent();
      return;
    }

    dom.quoteBlock.classList.add("quote--exit");
    dom.quoteBlock.addEventListener(
      "animationend",
      () => {
        dom.quoteBlock.classList.remove("quote--exit");
        renderContent();
        dom.quoteBlock.classList.add("quote--enter");
        dom.quoteBlock.addEventListener(
          "animationend",
          () => dom.quoteBlock.classList.remove("quote--enter"),
          { once: true }
        );
      },
      { once: true }
    );
  }

  function handleRandomClick() {
    if (state.isShuffling || state.hugots.length === 0) return;
    const next = pickRandomHugot(state.currentHugot?.id ?? null);
    displayHugot(next);
  }

  /* ==========================================================================
     Surprise Me — shuffle animation
     ========================================================================== */

  function handleSurpriseClick() {
    if (state.isShuffling || state.hugots.length === 0) return;

    state.isShuffling = true;
    dom.surpriseButton.disabled = true;
    dom.surpriseButton.classList.add("is-shuffling");
    dom.randomButton.disabled = true;

    if (REDUCED_MOTION) {
      finishSurprise();
      return;
    }

    // Precompute the flicker pool once (excluding only the hugot shown before
    // the shuffle started) instead of re-filtering the full list on every tick.
    const excludeId = state.currentHugot?.id ?? null;
    const flickerPool = state.hugots.length > 1
      ? state.hugots.filter((h) => h.id !== excludeId)
      : state.hugots;

    // Hide the flicker from assistive tech: only the settled result should
    // be announced, not every 70ms frame of the shuffle.
    dom.quoteText.setAttribute("aria-hidden", "true");
    dom.quoteBlock.setAttribute("aria-busy", "true");

    const startedAt = performance.now();

    const tick = () => {
      const elapsed = performance.now() - startedAt;
      if (elapsed >= SHUFFLE_DURATION_MS) {
        finishSurprise(flickerPool);
        return;
      }
      const flash = flickerPool[randomIndex(flickerPool.length)];
      dom.quoteText.textContent = flash.text;
      dom.quoteIndex.textContent = `#${String(flash.id).padStart(2, "0")}`;

      // Restart the per-tick flicker animation so each frame gets a tiny
      // bit of motion instead of a hard text-cut.
      dom.quoteText.classList.remove("quote__text--flicker");
      void dom.quoteText.offsetWidth;
      dom.quoteText.classList.add("quote__text--flicker");

      window.setTimeout(tick, SHUFFLE_TICK_MS);
    };

    tick();
  }

  function finishSurprise(flickerPool) {
    const pool = flickerPool ?? state.hugots;
    const finalHugot = pool[randomIndex(pool.length)];

    dom.quoteText.classList.remove("quote__text--flicker");
    dom.quoteText.removeAttribute("aria-hidden");
    dom.quoteBlock.removeAttribute("aria-busy");

    displayHugot(finalHugot);

    dom.surpriseButton.classList.remove("is-shuffling");
    dom.surpriseButton.disabled = false;
    dom.randomButton.disabled = false;
    state.isShuffling = false;
  }

  /* ==========================================================================
     Copy to clipboard
     ========================================================================== */

  async function handleCopyClick() {
    if (!state.currentHugot) return;

    try {
      await copyText(state.currentHugot.text);
      flashCopyButton();
      showToast("Nakopya na sa clipboard.", "success");
    } catch (err) {
      console.error("Copy failed:", err);
      showToast("Hindi na-copy. Subukan ulit.", "error");
    }
  }

  async function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    // Fallback for older/non-secure contexts
    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
  }

  function flashCopyButton() {
    const originalLabel = "Kopyahin";
    dom.copyButtonLabel.textContent = "Nakopya!";
    dom.copyButton.disabled = true;
    window.setTimeout(() => {
      dom.copyButtonLabel.textContent = originalLabel;
      dom.copyButton.disabled = false;
    }, 1500);
  }

  /* ==========================================================================
     Favorites
     ========================================================================== */

  function loadFavorites() {
    state.favorites = readStorage(STORAGE_KEYS.favorites, []);
    renderFavoritesCount();
  }

  function saveFavorites() {
    writeStorage(STORAGE_KEYS.favorites, state.favorites);
    renderFavoritesCount();
  }

  function isFavorite(id) {
    return state.favorites.some((f) => f.id === id);
  }

  function toggleFavorite() {
    if (!state.currentHugot) return;
    const { id, text } = state.currentHugot;

    if (isFavorite(id)) {
      state.favorites = state.favorites.filter((f) => f.id !== id);
      showToast("Tinanggal sa paborito.", "success");
    } else {
      state.favorites = [{ id, text }, ...state.favorites];
      showToast("Idinagdag sa paborito.", "success");
      popHeart();
    }

    saveFavorites();
    updateFavoriteButtonState();
    renderFavoritesList();
  }

  function updateFavoriteButtonState() {
    if (!state.currentHugot) return;
    const active = isFavorite(state.currentHugot.id);
    dom.favoriteButton.classList.toggle("is-active", active);
    dom.favoriteButton.setAttribute("aria-pressed", String(active));
    dom.favoriteButton.setAttribute(
      "aria-label",
      active ? "Alisin sa paborito" : "Idagdag sa paborito"
    );
  }

  function popHeart() {
    const icon = dom.favoriteButton.querySelector(".heart-icon");
    if (!icon || REDUCED_MOTION) return;
    icon.classList.remove("is-popping");
    // Force reflow to restart the animation reliably
    void icon.offsetWidth;
    icon.classList.add("is-popping");
  }

  function renderFavoritesCount() {
    const count = state.favorites.length;
    dom.favoritesCount.textContent = String(count);
    dom.favoritesCount.hidden = count === 0;
  }

  function renderFavoritesList() {
    const hasFavorites = state.favorites.length > 0;
    dom.drawerEmpty.hidden = hasFavorites;
    dom.drawerList.hidden = !hasFavorites;

    if (!hasFavorites) {
      dom.drawerList.innerHTML = "";
      return;
    }

    dom.drawerList.innerHTML = state.favorites
      .map(
        (fav) => `
        <li class="drawer__item" data-fav-id="${fav.id}">
          <p class="drawer__item-text">${escapeHtml(fav.text)}</p>
          <div class="drawer__item-actions">
            <button type="button" class="drawer__item-action" data-action="copy" aria-label="Kopyahin ang paboritong hugot">
              Kopyahin
            </button>
            <button type="button" class="drawer__item-action drawer__item-action--danger" data-action="remove" aria-label="Alisin sa paborito">
              Alisin
            </button>
          </div>
        </li>`
      )
      .join("");
  }

  /** Event delegation for favorites list item actions (copy / remove). */
  function handleDrawerListClick(event) {
    const button = event.target.closest("button[data-action]");
    if (!button) return;

    const item = button.closest("[data-fav-id]");
    const favId = Number(item.dataset.favId);
    const action = button.dataset.action;
    const favorite = state.favorites.find((f) => f.id === favId);
    if (!favorite) return;

    if (action === "copy") {
      copyText(favorite.text)
        .then(() => showToast("Nakopya na sa clipboard.", "success"))
        .catch(() => showToast("Hindi na-copy. Subukan ulit.", "error"));
      return;
    }

    if (action === "remove") {
      item.classList.add("is-removing");
      item.addEventListener(
        "animationend",
        () => {
          state.favorites = state.favorites.filter((f) => f.id !== favId);
          saveFavorites();
          renderFavoritesList();
          if (state.currentHugot?.id === favId) updateFavoriteButtonState();
        },
        { once: true }
      );
      // Fallback in case animation is skipped
      window.setTimeout(() => {
        if (item.isConnected) {
          state.favorites = state.favorites.filter((f) => f.id !== favId);
          saveFavorites();
          renderFavoritesList();
        }
      }, 300);
    }
  }

  /* ==========================================================================
     Favorites drawer open/close
     ========================================================================== */

  let lastFocusedElement = null;
  let releaseDrawerFocusTrap = null;

  function openDrawer() {
    lastFocusedElement = document.activeElement;
    dom.drawerOverlay.hidden = false;
    dom.favoritesDrawer.hidden = false;
    dom.favoritesToggle.setAttribute("aria-expanded", "true");
    dom.drawerClose.focus();
    document.body.style.overflow = "hidden";
    setBackgroundInert([dom.favoritesDrawer, dom.drawerOverlay, dom.toastRegion], true);
    releaseDrawerFocusTrap = trapFocus(dom.favoritesDrawer, () => !dom.favoritesDrawer.hidden);
  }

  function closeDrawer() {
    dom.favoritesDrawer.classList.add("is-closing");
    dom.favoritesToggle.setAttribute("aria-expanded", "false");

    const cleanup = () => {
      dom.favoritesDrawer.hidden = true;
      dom.drawerOverlay.hidden = true;
      dom.favoritesDrawer.classList.remove("is-closing");
      document.body.style.overflow = "";
      setBackgroundInert([dom.favoritesDrawer, dom.drawerOverlay, dom.toastRegion], false);
      releaseDrawerFocusTrap?.();
      releaseDrawerFocusTrap = null;
      lastFocusedElement?.focus();
    };

    if (REDUCED_MOTION) {
      cleanup();
      return;
    }
    dom.favoritesDrawer.addEventListener("animationend", cleanup, { once: true });
    window.setTimeout(cleanup, 400);
  }

  /* ==========================================================================
     Submit Hugot modal
     ========================================================================== */

  let releaseModalFocusTrap = null;

  function openModal() {
    lastFocusedElement = document.activeElement;
    dom.modalOverlay.hidden = false;
    dom.submitModal.hidden = false;
    dom.submitName.focus();
    document.body.style.overflow = "hidden";
    setBackgroundInert([dom.submitModal, dom.modalOverlay, dom.toastRegion], true);
    releaseModalFocusTrap = trapFocus(dom.submitModal, () => !dom.submitModal.hidden);
  }

  function closeModal() {
    dom.submitModal.classList.add("is-closing");

    const cleanup = () => {
      dom.submitModal.hidden = true;
      dom.modalOverlay.hidden = true;
      dom.submitModal.classList.remove("is-closing");
      document.body.style.overflow = "";
      setBackgroundInert([dom.submitModal, dom.modalOverlay, dom.toastRegion], false);
      releaseModalFocusTrap?.();
      releaseModalFocusTrap = null;
      resetSubmitForm();
      lastFocusedElement?.focus();
    };

    if (REDUCED_MOTION) {
      cleanup();
      return;
    }
    dom.submitModal.addEventListener("animationend", cleanup, { once: true });
    window.setTimeout(cleanup, 400);
  }

  function resetSubmitForm() {
    dom.submitForm.reset();
    dom.submitTextCount.textContent = `0 / ${MAX_HUGOT_LENGTH}`;
    dom.submitTextCount.classList.remove("is-near-limit");
    clearFieldError();
  }

  function handleSubmitTextInput() {
    const length = dom.submitText.value.length;
    dom.submitTextCount.textContent = `${length} / ${MAX_HUGOT_LENGTH}`;
    dom.submitTextCount.classList.toggle("is-near-limit", length >= MAX_HUGOT_LENGTH - 30);
    if (length > 0) clearFieldError();
  }

  function setFieldError(message) {
    dom.submitText.closest(".field").classList.add("has-error");
    dom.submitTextError.textContent = message;
  }

  function clearFieldError() {
    dom.submitText.closest(".field").classList.remove("has-error");
    dom.submitTextError.textContent = "";
  }

  function validateSubmission(text) {
    if (!text.trim()) {
      return "Kailangan ng hugot text bago ipadala.";
    }
    if (text.length > MAX_HUGOT_LENGTH) {
      return `Sobra sa limit. ${MAX_HUGOT_LENGTH} characters lang ang pwede.`;
    }
    return null;
  }

  /**
   * Simulated submission using localStorage.
   * Structured to mirror a real API call so swapping in `fetch()` later is a
   * drop-in replacement — see the comment below.
   */
  async function submitHugot({ name, text }) {
    // --- Simulated network latency ---
    await new Promise((resolve) => setTimeout(resolve, 650));

    const submissions = readStorage(STORAGE_KEYS.submissions, []);
    const entry = {
      id: Date.now(),
      name: name.trim() || "Anonymous",
      text: text.trim(),
      submittedAt: new Date().toISOString(),
    };
    submissions.push(entry);
    writeStorage(STORAGE_KEYS.submissions, submissions);

    /* To swap this for a real API later, replace the body above with:
     *
     * const response = await fetch("/api/hugot", {
     *   method: "POST",
     *   headers: { "Content-Type": "application/json" },
     *   body: JSON.stringify({ name, text }),
     * });
     * if (!response.ok) throw new Error("Submission failed");
     * return response.json();
     */
    return entry;
  }

  async function handleSubmitFormSubmit(event) {
    event.preventDefault();
    if (state.isSubmitting) return; // guard against spam clicking

    const name = dom.submitName.value;
    const text = dom.submitText.value;
    const validationError = validateSubmission(text);

    if (validationError) {
      setFieldError(validationError);
      dom.submitText.focus();
      return;
    }

    clearFieldError();
    state.isSubmitting = true;
    dom.submitFormButton.disabled = true;
    dom.submitFormButtonLabel.textContent = "Ipinapadala\u2026";

    try {
      await submitHugot({ name, text });
      showToast("Salamat! Naipadala ang hugot mo.", "success");
      closeModal();
    } catch (err) {
      console.error("Submission failed:", err);
      showToast("Hindi naipadala. Subukan ulit.", "error");
    } finally {
      state.isSubmitting = false;
      dom.submitFormButton.disabled = false;
      dom.submitFormButtonLabel.textContent = "Ipadala ang Hugot";
    }
  }

  /* ==========================================================================
     Button ripple effect (event delegation on document)
     ========================================================================== */

  function handleRippleClick(event) {
    const button = event.target.closest(".button");
    if (!button || button.disabled || REDUCED_MOTION) return;

    const rect = button.getBoundingClientRect();
    const size = Math.max(rect.width, rect.height) * 1.6;
    const x = event.clientX - rect.left - size / 2;
    const y = event.clientY - rect.top - size / 2;

    const ripple = document.createElement("span");
    ripple.className = "button__ripple";
    ripple.style.width = `${size}px`;
    ripple.style.height = `${size}px`;
    ripple.style.left = `${x}px`;
    ripple.style.top = `${y}px`;

    button.appendChild(ripple);
    ripple.addEventListener("animationend", () => ripple.remove(), { once: true });
  }

  /* ==========================================================================
     Keyboard handling (Escape to close overlays)
     ========================================================================== */

  function handleGlobalKeydown(event) {
    if (event.key !== "Escape") return;
    if (!dom.submitModal.hidden) {
      closeModal();
      return;
    }
    if (!dom.favoritesDrawer.hidden) {
      closeDrawer();
    }
  }

  /* ==========================================================================
     Event wiring
     ========================================================================== */

  function bindEvents() {
    dom.retryButton.addEventListener("click", loadHugots);

    dom.randomButton.addEventListener("click", handleRandomClick);
    dom.surpriseButton.addEventListener("click", handleSurpriseClick);
    dom.copyButton.addEventListener("click", handleCopyClick);
    dom.favoriteButton.addEventListener("click", toggleFavorite);

    dom.favoritesToggle.addEventListener("click", openDrawer);
    dom.drawerClose.addEventListener("click", closeDrawer);
    dom.drawerOverlay.addEventListener("click", closeDrawer);
    dom.drawerList.addEventListener("click", handleDrawerListClick);

    dom.submitOpenButton.addEventListener("click", openModal);
    dom.modalClose.addEventListener("click", closeModal);
    dom.modalOverlay.addEventListener("click", closeModal);
    dom.submitForm.addEventListener("submit", handleSubmitFormSubmit);
    dom.submitText.addEventListener("input", handleSubmitTextInput);

    document.addEventListener("keydown", handleGlobalKeydown);
    document.addEventListener("click", handleRippleClick);
  }

  /* ==========================================================================
     Init
     ========================================================================== */

  function init() {
    bindEvents();
    loadFavorites();
    renderFavoritesList();
    loadHugots();
  }

  document.addEventListener("DOMContentLoaded", init);
})();
